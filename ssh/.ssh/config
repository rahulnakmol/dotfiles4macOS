# Per-machine host rules live in ~/.ssh/config.d/. OpenSSH ignores this
# when nothing matches, so a machine without that directory is unchanged.
# Those files stay off this public repo: they name which 1Password key
# authenticates to GitHub.
Include config.d/*.conf

Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
