[user]
	name = Rahul N Akmol
	email = rahulnakmol@gmail.com
	# Commit/tag signing only — this public key (1Password SSH key). Do not substitute another vault key.
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJCF4TkApTmwn6YG96qVb3HvDfr2v48glWCgF4pjNIvD

[gpg]
	format = ssh

[gpg "ssh"]
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
	allowedSignersFile = ~/.ssh/allowed_signers

[commit]
	gpgsign = true
	verbose = true

[tag]
	gpgsign = true
	sort = version:refname

[core]
	editor = nvim
	excludesfile = ~/.config/git/ignore
	quotePath = false
	whitespace = blank-at-eol,blank-at-eof,space-before-tab
	untrackedCache = true
	fsmonitor = true
	pager = less -FRX

[pager]
	status = false
	branch = false
	config = false

[status]
	showStash = true
	relativePaths = true

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true

[merge]
	conflictStyle = zdiff3
	autoStash = true

[rerere]
	enabled = true
	autoUpdate = true

[pull]
	rebase = true

[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true

[fetch]
	prune = true
	pruneTags = true
	parallel = 4
	writeCommitGraph = true

[push]
	default = simple
	autoSetupRemote = true
	followTags = true
	useForceIfIncludes = true

[branch]
	sort = -committerdate

[column]
	ui = auto

[init]
	defaultBranch = main

[alias]
	st = status -sb
	sw = switch
	br = branch -vv
	ci = commit
	amend = commit --amend
	fixup = commit --fixup
	unstage = restore --staged
	last = log -1 --stat
	lg = log --oneline --decorate --graph --all
	ds = diff --staged
	incoming = log --oneline ..@{u}
	outgoing = log --oneline @{u}..
	pushf = push --force-with-lease
	root = rev-parse --show-toplevel
	aliases = config --get-regexp ^alias\\.

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

# Per-machine overrides. Git silently ignores a missing include.
# config.local is the headless-machine escape hatch (see docs/modules/git.md).
# git-private is this laptop's account split. It lives outside the Stow
# tree so a folded ~/.config/git symlink cannot carry it into this public repo.
# That directory holds one gitconfig per GitHub login. Last file wins.
[include]
	path = ~/.config/git/config.local
[include]
	path = ~/.config/git-private/config.local
