[user]
	name = Rahul N Akmol
	email = rahulnakmol@gmail.com
	# Commit/tag signing only — this public key (1Password SSH key). Do not substitute another vault key.
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJCF4TkApTmwn6YG96qVb3HvDfr2v48glWCgF4pjNIvD

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
  allowedSignersFile = ~/.ssh/allowed_signers

[commit]
  gpgsign = true

[tag]
  gpgsign = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[init]
	defaultBranch = main

# Per-machine overrides. Git silently ignores this if the file does not
# exist, so machines without one are unaffected. Last-wins: anything set
# in config.local overrides the shared values above. Gitignored.
[include]
    path = ~/.config/git/config.local
