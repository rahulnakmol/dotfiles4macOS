  "windowActions": [
    {
      "id": "maximize",
      "name": "Maximize",
      "key": "Return",
      "description": "Fill the available desktop; stay out of native fullscreen"
    },
    {
      "id": "restore",
      "name": "Restore window",
      "key": "Backspace",
      "description": "Undo the last Rectangle size and position"
    },
    {
      "id": "left-half",
      "name": "Left half",
      "key": ",",
      "description": "Fit the left half"
    },
    {
      "id": "right-half",
      "name": "Right half",
      "key": ".",
      "description": "Fit the right half"
    },
    {
      "id": "first-third",
      "name": "Left third",
      "key": "[",
      "description": "Fit the left third"
    },
    {
      "id": "center-third",
      "name": "Centre third",
      "key": "]",
      "description": "Fit the centre third"
    },
    {
      "id": "last-third",
      "name": "Right third",
      "key": "\\",
      "description": "Fit the right third"
    },
    {
      "id": "first-two-thirds",
      "name": "Left two-thirds",
      "key": ";",
      "description": "Fit the left two-thirds"
    },
    {
      "id": "last-two-thirds",
      "name": "Right two-thirds",
      "key": "'",
      "description": "Fit the right two-thirds"
    },
    {
      "id": "prev-space",
      "name": "Move window to previous desktop",
      "key": "\u2212",
      "description": "Rectangle title-bar drag; requires Control+Left enabled"
    },
    {
      "id": "next-space",
      "name": "Move window to next desktop",
      "key": "=",
      "description": "Rectangle title-bar drag; requires Control+Right enabled"
    },
    {
      "id": "previous-display",
      "name": "Move window to previous display",
      "key": "\u2190",
      "description": "Move to the previous connected monitor"
    },
    {
      "id": "next-display",
      "name": "Move window to next display",
      "key": "\u2192",
      "description": "Move to the next connected monitor"
    }
  ],
