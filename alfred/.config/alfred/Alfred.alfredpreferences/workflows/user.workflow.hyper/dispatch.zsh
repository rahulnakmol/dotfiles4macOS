#!/bin/zsh
# Generated by scripts/build-hyper-config.mjs. Fixed actions only; never eval a query.
set -eu
workflow_dir="${0:A:h}"
launch() {
  if [[ "${HYPER_DRY_RUN:-0}" == 1 ]]; then
    printf '%s\n' "$@"
  else
    /usr/bin/open "$@"
  fi
}
