  'app:amp') launch -b 'com.ampcode.amp.macos' ;;
  'app:obsidian') launch -b 'md.obsidian' ;;
  'app:edge') launch -b 'com.microsoft.edgemac' ;;
  'app:teams') launch -b 'com.microsoft.teams2' ;;
  'app:slack') launch -b 'com.tinyspeck.slackmacgap' ;;
  'app:word') launch -b 'com.microsoft.Word' ;;
  'app:excel') launch -b 'com.microsoft.Excel' ;;
  'app:powerpoint') launch -b 'com.microsoft.Powerpoint' ;;
  'app:safari') launch -b 'com.apple.Safari' ;;
  'app:finalcut') launch -b 'com.apple.FinalCut' ;;
  'app:motion') launch -b 'com.apple.motionapp' ;;
  'app:compressor') launch -b 'com.apple.Compressor' ;;
  'layout:Work') launch -g 'dockflow://switch?id=01BAE638-6C40-47C3-A97D-F52F4CB3A9A3'
    launch -g 'rectangle-pro://execute-layout?name=Work' ;;
  'layout:Work Balanced') launch -g 'dockflow://switch?id=01BAE638-6C40-47C3-A97D-F52F4CB3A9A3'
