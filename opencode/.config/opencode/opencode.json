{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-5",
  "small_model": "github-copilot/claude-haiku-4.5",
  "default_agent": "sdlc",
  "autoupdate": false,
  "instructions": [
    "SDLC_METHOD.md",
    "SDLC_LOOP.md"
  ],
  "plugin": [
    "./plugins/caveman/plugin.js"
  ],
  "mcp": {
    "caveman-shrink": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "caveman-shrink"
      ],
      "enabled": true
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.envrc": "deny",
      "**/secrets.yaml": "deny",
      "**/secrets.yml": "deny",
      "**/secret.yaml": "deny",
      "**/secret.yml": "deny",
      "**/credentials.json": "deny",
      "**/credentials.yaml": "deny",
      "**/service-account*.json": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.asc": "deny",
      "**/*.tfvars": "deny",
      "**/*.tfstate": "deny",
      "**/*.tfstate.backup": "deny",
      "**/.terraform/**": "deny",
      "**/.npmrc": "deny",
      "**/.yarnrc.yml": "deny",
      "**/hosts.yml": "deny",
      "**/.env.example": "allow",
      "**/*.env.example": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.envrc": "deny",
      "**/secrets.yaml": "deny",
      "**/secrets.yml": "deny",
      "**/secret.yaml": "deny",
      "**/secret.yml": "deny",
      "**/credentials.json": "deny",
      "**/credentials.yaml": "deny",
      "**/service-account*.json": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.asc": "deny",
      "**/*.tfvars": "deny",
      "**/*.tfstate": "deny",
      "**/*.tfstate.backup": "deny",
      "**/.terraform/**": "deny",
      "**/.npmrc": "deny",
      "**/.yarnrc.yml": "deny",
      "**/hosts.yml": "deny",
      "**/.env.example": "allow",
      "**/*.env.example": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "git push *": "ask",
      "git reset --hard*": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask",
      "az group delete*": "ask",
      "gcloud projects delete*": "ask"
    },
    "external_directory": {
      "*": "allow",
      "~/.ssh/id_*": "deny",
      "~/.ssh/*_rsa": "deny",
      "~/.ssh/*_ed25519": "deny",
      "~/.ssh/*_ecdsa": "deny",
      "~/.ssh/*_dsa": "deny",
      "~/.ssh/authorized_keys": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/credentials": "deny",
      "~/.aws/config": "deny",
      "~/.aws/sso/**": "deny",
      "~/.azure/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.config/op/**": "deny",
      "~/.config/1Password/**": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.config/git/credentials": "deny",
      "~/.config/rclone/rclone.conf": "deny",
      "~/.docker/config.json": "deny",
      "~/.kube/config": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.pypirc": "deny",
      "~/.password-store/**": "deny",
      "~/.terraform.d/credentials.tfrc.json": "deny",
      "~/.git-credentials": "deny",
      "~/.vault-token": "deny",
      "~/.age/**": "deny",
      "~/.config/doctl/**": "deny",
      "~/.config/netlify/**": "deny",
      "~/.config/fly/**": "deny",
      "~/.config/heroku/credentials.json": "deny"
    }
  }
}
