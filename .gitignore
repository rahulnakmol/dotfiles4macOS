# OS / editor artifacts
.DS_Store
**/*.mdb
**/*.log
**/.swp
**/.swo
**/*.bak
*~

# Sensitive credentials — never commit tokens or keys
gh/.config/gh/hosts.yml
**/.ssh/known_hosts*
**/.ssh/id_*
**/.ssh/*.pem
**/.ssh/*.key
**/*.env
**/.env*
**/*secret*
**/*token*

# Claude Code — ignore everything except configuration files
claude/.claude/*
!claude/.claude/settings.json
!claude/.claude/keybindings.json
!claude/.claude/statusline.sh
!claude/.claude/CLAUDE.md
!claude/.claude/rules/
!claude/.claude/skills/

# Cursor — ignore everything except user rules
cursor/.cursor/*
!cursor/.cursor/rules/

# Module-specific ephemeral data
nvim/.config/nvim/lazy-lock.json
**/zsh/*.local
**/bash/*.local
**/tmux/plugins/*
**/karabiner/automatic_backups/*
**/karabiner/assets/*
**/zed/conversations/*
zed/.config/zed/settings_backup.json

# Session / remember data (ephemeral to this machine)
.remember/

# Auto-generated wiki (regeneratable per commit)
droid-wiki/

# Installed skill agents (third-party, re-installable via skills-lock.json)
.agents/
