{
  "when_closing_with_no_tabs": "close_window",
  "confirm_quit": true,
  "title_bar": {
    "show_branch_icon": false
  },
  "language_models": {
    "openai_compatible": {
      "Azure OpenAI": {
        "api_url": "https://azai-eus2-connected-auto-dev-01.cognitiveservices.azure.com/openai/v1",
        "available_models": [
          {
            "name": "gpt-5-codex",
            "max_tokens": 200000,
            "max_output_tokens": 128000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": false
            }
          },
          {
            "name": "gpt-5-pro",
            "max_tokens": 200000,
            "max_output_tokens": 128000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": false
            }
          },
          {
            "name": "model-router",
            "max_tokens": 500000,
            "max_output_tokens": 128000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": false
            }
          }
        ]
      }
    }
  },
  "context_servers": {
    "azure-context-server": {
      "source": "extension",
      "enabled": true,
      "settings": {
        "enable_production_credentials": false
      }
    },
    "mcp-server-github": {
      "source": "extension",
      "enabled": true,
      "settings": {
        "github_personal_access_token": "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"
      }
    },
    "mcp-server-context7": {
      "source": "extension",
      "enabled": true,
      "settings": {
        "context7_api_key": "ctx7sk-fea429eb-d767-477e-b49d-65d020ea2e39"
      }
    }
  },
  "features": {
    "edit_prediction_provider": "copilot"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato"
  },
  "agent": {
    "message_editor_min_lines": 5,
    "play_sound_when_agent_done": true,
    "enable_feedback": false,
    "always_allow_tool_actions": true,
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-4-5-sonnet"
    }
  },
  "vim_mode": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato"
  },
  "tab_bar": {
    "show": false
  },
  "scrollbar": {
    "show": "never"
  },
  "relative_line_numbers": true,
  "format_on_save": "on",
  "ui_font_family": "FantasqueSansM Nerd Font",
  "ui_font_size": 16.0,
  "buffer_font_family": "ZedMono Nerd Font",
  "buffer_font_size": 16.0,
  "buffer_line_height": "comfortable",
  "terminal": {
    "font_family": "ZedMono Nerd Font"
  }
