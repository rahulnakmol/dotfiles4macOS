theme = dark:Catppuccin Mocha,light:Catppuccin Latte
font-family = "Mononoki Nerd Font"
font-size = 16
window-width = 200
window-height = 50
window-padding-x = 2
window-padding-y = 2
window-colorspace = display-p3
window-theme = ghostty
shell-integration = zsh
background-opacity = 0.8
background-blur-radius = 20
